# Orchestrator connection (required)
ORCHESTRATOR_URL=https://orchestrator.finopsbricks.com
ORCHESTRATOR_API_KEY=
ORCHESTRATOR_API_SECRET=

# Worker identity (required)
WORKER_LOCATION=

# Worker settings
POLL_INTERVAL_MS=2000

# Optional: OpenRouter API key (for LLM steps via @fob/lib-worker-ai)
# OPENROUTER_API_KEY=

# Optional: Google service account (for Sheets/Drive via @fob/lib-worker-google)
# GOOGLE_SERVICE_ACCOUNT_KEY=
