# Orchestrator connection (required)
ORCHESTRATOR_URL=https://orchestrator.assemblyline.sh
ORCHESTRATOR_API_KEY=
ORCHESTRATOR_API_SECRET=

# Where this factory session runs; must match the location of the lines it serves (required)
FACTORY_LOCATION={{LOCATION}}

POLL_INTERVAL_MS=2000

# Optional: OpenRouter API key, for AI steps
# OPENROUTER_API_KEY=
